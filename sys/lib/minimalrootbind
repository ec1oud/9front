# this is intended to be run from the root of wherever the repository is mounted or checked out:
# . sys/lib/smallrootbind
riscvsrc=`{pwd}

# bind /amd64 to /n/amd64 to preserve write permission there,
# but give up write permission on /amd64 by remounting it read-only.
bind /$cputype /n/$cputype
if (!(test -r /srv/$cputype))
    srvfs -R $cputype /n/$cputype
mount -b /srv/$cputype /$cputype

# for each source that is intentionally modified in this repository,
# allow overwriting the lib or binary, and bind the source dir over the one in /sys/src
for (i in ja jc jl) {
    bind /n/$cputype/bin/$i /$cputype/bin/$i
    if (!(test -d /sys/src/cmd/$i))
        mkdir /sys/src/cmd/$i
    bind -c $riscvsrc/sys/src/cmd/$i /sys/src/cmd/$i
}
for (i in libc libmach libsec) {
    bind -c $riscvsrc/sys/src/$i /sys/src/$i
}
# we need to rebuild libmach.a, so allow overwriting
bind /n/$cputype/lib/libmach.a /$cputype/lib/libmach.a
# we need to build ar, so allow overwriting and bind the source
bind /n/$cputype/bin/ar /$cputype/bin/ar
bind $riscvsrc/sys/src/cmd/ar.c /sys/src/cmd/ar.c
# we need to build the kernel, of course
if (!(test -d /sys/src/9/riscv64))
    mkdir /sys/src/9/riscv64
bind -c $riscvsrc/sys/src/9/riscv64 /sys/src/9/riscv64

# for each include file that is intentionally modified in this repository,
# bind it over the one in /sys/src
for (i in a.out.h mach.h) {
    bind $riscvsrc/sys/include/$i /sys/include/$i
}

